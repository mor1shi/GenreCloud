{
  "manifest_version": 3,
  "name": "GenreCloud",
  "version": "1.1.0",
  "description": "Builds a genre cloud from the tracks you like. Supports Yandex Music and Spotify; not affiliated with either service.",
  "permissions": [
    "scripting",
    "declarativeNetRequest",
    "storage",
    "tabs",
    "identity"
  ],
  "host_permissions": [
    "https://music.yandex.ru/*",
    "https://music.yandex.com/*",
    "https://music.yandex.kz/*",
    "https://music.yandex.by/*",
    "https://api.music.yandex.ru/*",
    "https://api.music.yandex.net/*",
    "https://accounts.spotify.com/*",
    "https://api.spotify.com/*",
    "https://musicbrainz.org/*",
    "https://api.discogs.com/*"
  ],
  "action": {
    "default_title": "GenreCloud"
  },
  "background": {
    "service_worker": "background.js"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "catalog-user-agent",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://music.yandex.ru/*",
        "https://music.yandex.com/*",
        "https://music.yandex.kz/*",
        "https://music.yandex.by/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:"
  }
}
