{
  "name": "genrecloud",
  "version": "1.1.0",
  "private": false,
  "type": "module",
  "description": "Browser extension that builds a genre cloud from the tracks you like.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/morishi/genrecloud.git"
  },
  "keywords": [
    "browser-extension",
    "music",
    "genres",
    "word-cloud",
    "yandex-music",
    "spotify",
    "discogs",
    "musicbrainz"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/package-extension.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "bench": "vitest run bench/benchmark.test.ts --reporter=verbose"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.1.10",
    "react-dom": "^19.1.10"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.10.2",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.1",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.3.8",
    "vitest": "^4.0.13"
  }
}
